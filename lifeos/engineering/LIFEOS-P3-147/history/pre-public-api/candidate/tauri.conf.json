{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeOS Conversation",
  "version": "0.1.0",
  "identifier": "local.lifeos.p3-147",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [
        "main"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "LifeOS · P3-146 · 合成离线",
        "url": "index.html",
        "width": 1280,
        "height": 1024,
        "decorations": true,
        "minWidth": 560,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": []
  }
}