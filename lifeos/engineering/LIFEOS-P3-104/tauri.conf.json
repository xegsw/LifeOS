{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeOS P3-104",
  "version": "0.1.0",
  "identifier": "local.lifeos.p3-104",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    },
    "windows": [
      {
        "label": "main",
        "title": "LifeOS 今日",
        "url": "default-recovery.html",
        "width": 1024,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
