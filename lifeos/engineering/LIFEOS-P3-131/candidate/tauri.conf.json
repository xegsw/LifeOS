{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LifeOS P3-131 Candidate Next Action",
  "version": "0.1.0",
  "identifier": "local.lifeos.p3-131",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["main"]
    },
    "windows": [
      {
        "label": "main",
        "title": "LifeOS · P3-131 Candidate Next Action",
        "url": "index.html",
        "width": 1280,
        "height": 1024,
        "decorations": false,
        "minWidth": 560,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
